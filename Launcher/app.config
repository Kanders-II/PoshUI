<?xml version="1.0" encoding="utf-8" ?>
<configuration>
  <system.diagnostics>
    <sources>
      <source name="Poshwizard" switchName="PoshwizardSwitch" switchType="System.Diagnostics.SourceSwitch">
        <listeners>
          <add name="logfile" type="System.Diagnostics.TextWriterTraceListener" initializeData="logs/Poshwizard.log">
            <filter type="System.Diagnostics.EventTypeFilter" initializeData="Verbose" />
          </add>
          <remove name="Default" />
        </listeners>
      </source>
    </sources>
    <switches>
      <add name="PoshwizardSwitch" value="All" />
    </switches>
  </system.diagnostics>

  <runtime>
    <!-- Ensure assemblies can be probed from a local 'bin' subfolder next to the exe -->
    <probing privatePath="bin" />
    <!-- Second half of the Per-Monitor V2 opt-in (app.manifest declares the awareness level). Setting this to
         false lets WPF re-render at the new DPI when the window moves between monitors with different scaling
         or the display scale changes at runtime; leaving it true keeps the legacy bitmap-stretch behavior. -->
    <AppContextSwitchOverrides value="Switch.System.Windows.DoNotScaleForDpiChanges=false" />
  </runtime>
</configuration>